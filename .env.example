# GoalTime - variables de entorno del frontend (Create React App).
# Copia este archivo a `.env.local` (no se versiona) y completa los valores.
# Solo se exponen al navegador las variables que empiezan por REACT_APP_;
# NUNCA pongas secretos reales aquí (todo lo de REACT_APP_* termina en el bundle público).

# Site key PÚBLICA de Google reCAPTCHA v2 para el formulario de contacto de la landing.
# Si se omite, el código usa la clave de producción por defecto.
REACT_APP_RECAPTCHA_SITE_KEY=

# URL del endpoint de Formspree que recibe el formulario de contacto
# (formato: https://formspree.io/f/<form-id>). Si se omite, se usa el de producción.
REACT_APP_FORMSPREE_ENDPOINT=

# Nota: src/shared/services/firebaseApp.js NO lee variables de entorno; la configuración web de
# Firebase está fija en el código (no es secreta, la protegen firestore.rules / storage.rules).
