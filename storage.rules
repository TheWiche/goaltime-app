rules_version = '2';

// GoalTime - Firebase Storage Security Rules
// - profile-photos/{userId}/{file}: solo el propio usuario escribe; lectura autenticada.
// - fields/{fieldId}/{file}: escribe el asociado dueño de la cancha o un admin
//   (rol leído de Firestore users/{uid}.role); lectura pública (fotos de canchas).
// - Imágenes: < 5 MB y image/png | image/jpeg | image/webp.
// - Todo lo demás: denegado.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc() != null ? userDoc().data.get('role', 'cliente') : 'cliente';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function ownsField(fieldId) {
      return signedIn()
        && role() == 'asociado'
        && firestore.get(/databases/(default)/documents/canchas/$(fieldId)).data.ownerId
           == request.auth.uid;
    }

    match /profile-photos/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /fields/{fieldId}/{fileName} {
      allow read: if true;
      allow create, update: if (isAdmin() || ownsField(fieldId)) && isValidImage();
      allow delete: if isAdmin() || ownsField(fieldId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
